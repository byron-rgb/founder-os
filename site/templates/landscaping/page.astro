---
// Landscaping template (Founder OS). Content comes from src/content/site.json,
// colours and fonts from the founder's design system. Sections with no content are hidden.
// Photos: put the founder's own photos in public/images/ and point to them in site.json.
import Site from '../layouts/Site.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';
const { hero, services = [], steps = [], gallery = [], why = [], reviews = [], faqs = [], proof = [], team, business: b } = site;
const beforeAfter = site.beforeAfter?.before && site.beforeAfter?.after ? site.beforeAfter : null;
const tel = b.phone ? `tel:${b.phone.replace(/\s/g, '')}` : null;
const featured = services.filter((s) => s.image).slice(0, 2);
const rest = services.filter((s) => !featured.includes(s));
// Gallery rows of 2 or 3 so the grid never leaves a gap, whatever the number of photos.
const spans = [];
for (let left = gallery.length, two = true; left > 0; two = !two) {
  const row = left === 1 ? 1 : left === 2 || left === 4 ? 2 : left === 3 ? 3 : two ? 2 : 3;
  for (let i = 0; i < row; i++) spans.push(12 / row);
  left -= row;
}
const whyIcons = ['clock', 'shield-check', 'handshake', 'leaf', 'star', 'check-circle'];
---
<Site overlay={true}>
  <!-- Hero: full photo, one message, two actions -->
  <section class:list={['hero', { 'no-photo': !hero.image }]}>
    {hero.image && <img class="hero-img" src={hero.image} alt={hero.imageAlt || ''} fetchpriority="high" />}
    <div class="wrap hero-copy">
      {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
      <h1>{hero.title}</h1>
      <p class="lead">{hero.text}</p>
      <div class="hero-ctas">
        <a class="btn" href="#quote">{site.cta}<Icon name="arrow-right" size={18} /></a>
        {tel && <a class="btn ghost" href={tel}><Icon name="phone" size={18} />{b.phone}</a>}
      </div>
    </div>
  </section>

  <!-- Proof strip -->
  {proof.length > 0 && <div class="proof">
    <ul class="wrap">{proof.map((p) => <li><Icon name="check-circle" size={22} weight="fill" />{p}</li>)}</ul>
  </div>}

  <!-- Services: up to two photo features, the rest as a priced list -->
  {services.length > 0 && <section class="section" id="services">
    <div class="wrap">
      <div class="sec-head reveal"><h2>{site.servicesTitle || 'What we do'}</h2>{site.servicesText && <p class="lead muted">{site.servicesText}</p>}</div>
      {featured.length > 0 && <div class:list={['svc-feature', { one: featured.length === 1 }]}>
        {featured.map((s) => <article class="svc-tile reveal">
          <img src={s.image} alt="" loading="lazy" />
          <div class="svc-tile-copy"><h3>{s.name}</h3><p>{s.text}</p>{s.from && <strong>{s.from}</strong>}</div>
        </article>)}
      </div>}
      {rest.length > 0 && <ul class="svc-list">
        {rest.map((s) => <li class="reveal"><div><h3>{s.name}</h3><p class="muted">{s.text}</p></div>{s.from && <strong>{s.from}</strong>}</li>)}
      </ul>}
    </div>
  </section>}

  <!-- Our work: before and after slider, then the gallery -->
  {(beforeAfter || gallery.length > 0) && <section class="section panel" id="work">
    <div class="wrap">
      <div class="sec-head reveal"><h2>{site.workTitle || 'Recent work'}</h2></div>
      {beforeAfter && <figure class="ba reveal">
        <div class="ba-frame" style="--pos:50%">
          <img src={beforeAfter.after} alt={`After: ${beforeAfter.caption || ''}`} loading="lazy" />
          <img class="ba-before" src={beforeAfter.before} alt={`Before: ${beforeAfter.caption || ''}`} loading="lazy" />
          <span class="ba-tag l">Before</span><span class="ba-tag r">After</span>
          <span class="ba-handle" aria-hidden="true"><Icon name="arrows-left-right" size={20} /></span>
          <input type="range" min="0" max="100" value="50" aria-label="Slide to compare before and after" />
        </div>
        {beforeAfter.caption && <figcaption>{beforeAfter.caption}</figcaption>}
      </figure>}
      {gallery.length > 0 && <div class="gallery">
        {gallery.map((g, i) => <figure class="reveal" style={`--span:${spans[i]}`}><div class="photo">{g.src ? <img src={g.src} alt={g.label} loading="lazy" /> : <span class="muted">Photo: {g.label}</span>}</div><figcaption>{g.label}</figcaption></figure>)}
      </div>}
    </div>
  </section>}

  <!-- How it works -->
  {steps.length > 0 && <section class="section" id="process">
    <div class="wrap">
      <div class="sec-head reveal"><h2>{site.stepsTitle || 'How it works'}</h2></div>
      <ol class="steps">{steps.map((s, i) => <li class="reveal"><span class="step-n">{i + 1}</span><h3>{s.title}</h3><p class="muted">{s.text}</p></li>)}</ol>
    </div>
  </section>}

  <!-- Why us, over a team photo -->
  {why.length > 0 && <section class:list={['why', { 'has-photo': team?.image }]}>
    {team?.image && <img class="why-img" src={team.image} alt={team.alt || ''} loading="lazy" />}
    <div class="wrap why-row">
      <div class="why-card reveal">
        <h2>{site.whyTitle || `Why ${b.name}`}</h2>
        <ul>{why.map((w, i) => <li><span class="why-ic"><Icon name={w.icon || whyIcons[i % whyIcons.length]} size={22} /></span><div><h3>{w.title}</h3><p class="muted">{w.text}</p></div></li>)}</ul>
      </div>
    </div>
  </section>}

  <!-- Reviews: only real ones, never examples -->
  {reviews.length > 0 && <section class="section panel" id="reviews">
    <div class="wrap reviews">
      <blockquote class="review-main reveal">
        <Icon name="quotes" size={44} weight="fill" />
        <p>{reviews[0].quote}</p>
        <footer>{reviews[0].name}{reviews[0].suburb && `, ${reviews[0].suburb}`}</footer>
      </blockquote>
      {reviews.length > 1 && <div class="review-side">{reviews.slice(1, 4).map((r) => <blockquote class="reveal"><p>{r.quote}</p><footer>{r.name}{r.suburb && `, ${r.suburb}`}</footer></blockquote>)}</div>}
    </div>
  </section>}

  <!-- FAQs and service areas -->
  {faqs.length > 0 && <section class="section" id="faqs">
    <div class="wrap faq-row">
      <div class="faq-side reveal">
        <h2>Questions</h2>
        {b.serviceAreas?.length > 0 && <div class="stack"><p class="muted">Where we work</p><ul class="areas">{b.serviceAreas.map((a) => <li><Icon name="map-pin" size={16} />{a}</li>)}</ul></div>}
        {tel && <p>Something else? <a href={tel}><strong>Call {b.phone}</strong></a></p>}
      </div>
      <div class="faq-list">
        {faqs.map((f) => <details class="reveal"><summary>{f.q}<Icon name="caret-down" size={20} /></summary><p class="muted">{f.a}</p></details>)}
      </div>
    </div>
  </section>}

  <QuoteForm />
</Site>

<script>
  // Before/after slider
  document.querySelectorAll('.ba-frame').forEach((f) => {
    const r = f.querySelector('input') as HTMLInputElement;
    r.addEventListener('input', () => (f as HTMLElement).style.setProperty('--pos', r.value + '%'));
  });
</script>

<style>
  /* Hero */
  .hero{position:relative;min-height:min(92dvh,860px);display:flex;align-items:flex-end;color:#fff;background:var(--c-text);overflow:hidden}
  .hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgb(10 10 10/.72) 0%,rgb(10 10 10/.45) 45%,rgb(10 10 10/.05) 80%),linear-gradient(0deg,rgb(10 10 10/.55),transparent 45%)}
  .hero.no-photo{color:var(--c-bg)}
  .hero.no-photo::after{display:none}
  .hero-copy{position:relative;z-index:1;display:flex;flex-direction:column;gap:20px;padding-block:140px clamp(56px,9vw,104px);width:100%}
  .hero-copy > *{max-width:640px}
  .hero .eyebrow{opacity:.9}
  .hero .lead{opacity:.92}
  .hero-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:8px}
  @media (prefers-reduced-motion:no-preference){.hero-copy > *{animation:in .9s cubic-bezier(.16,1,.3,1) both}.hero-copy > :nth-child(2){animation-delay:.08s}.hero-copy > :nth-child(3){animation-delay:.16s}.hero-copy > :nth-child(4){animation-delay:.24s}}
  @keyframes in{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}

  /* Proof strip */
  .proof{background:var(--c-accent);color:var(--c-on-accent)}
  .proof ul{list-style:none;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 32px;padding-block:20px;font-weight:700}
  .proof li{display:flex;align-items:center;gap:10px}

  /* Services */
  .svc-feature{display:grid;gap:20px;margin-bottom:48px}
  @media(min-width:760px){.svc-feature{grid-template-columns:1.25fr 1fr}.svc-feature.one{grid-template-columns:1fr}}
  .svc-tile{position:relative;min-height:420px;border-radius:var(--radius);overflow:hidden;color:#fff;display:flex;align-items:flex-end}
  .svc-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.16,1,.3,1)}
  .svc-tile:hover img{transform:scale(1.04)}
  .svc-tile::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgb(10 10 10/.88),rgb(10 10 10/.35) 55%,rgb(10 10 10/0))}
  .svc-tile-copy{position:relative;z-index:1;padding:28px;display:flex;flex-direction:column;gap:8px;max-width:440px}
  .svc-tile-copy h3{font-size:24px}
  .svc-tile-copy strong{color:var(--c-accent)}
  .svc-list{list-style:none;margin:0;padding:0;display:grid;column-gap:56px}
  @media(min-width:760px){.svc-list{grid-template-columns:1fr 1fr}}
  .svc-list li{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;padding-block:24px;border-top:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .svc-list li div{display:flex;flex-direction:column;gap:6px}
  .svc-list strong{white-space:nowrap;font-size:15px;padding-top:2px}

  /* Before / after */
  .ba{margin:0 0 32px}
  .ba-frame{position:relative;aspect-ratio:16/8;border-radius:var(--radius);overflow:hidden;background:var(--c-text);user-select:none}
  .ba-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .ba-before{clip-path:inset(0 calc(100% - var(--pos)) 0 0)}
  .ba-frame::after{content:"";position:absolute;top:0;bottom:0;left:var(--pos);width:3px;margin-left:-1.5px;background:#fff;pointer-events:none}
  .ba-handle{position:absolute;top:50%;left:var(--pos);z-index:2;width:48px;height:48px;margin:-24px 0 0 -24px;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;box-shadow:0 6px 20px rgb(0 0 0/.3);pointer-events:none}
  .ba-tag{position:absolute;top:16px;z-index:2;background:rgb(10 10 10/.6);color:#fff;font-size:13px;font-weight:700;padding:6px 10px;border-radius:var(--radius);pointer-events:none}
  .ba-tag.l{left:16px}.ba-tag.r{right:16px}
  .ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0;z-index:3}
  .ba input:focus-visible ~ .ba-handle,.ba-frame:has(input:focus-visible) .ba-handle{outline:3px solid var(--c-accent);outline-offset:3px}
  .ba figcaption,.gallery figcaption{margin-top:12px;font-size:var(--t-small);opacity:.75}
  @media(max-width:700px){.ba-frame{aspect-ratio:4/3}}
  .gallery{display:grid;gap:20px}
  .gallery figure{margin:0}
  .gallery .photo{aspect-ratio:4/3}
  @media(min-width:760px){.gallery{grid-template-columns:repeat(12,1fr)}.gallery figure{grid-column:span var(--span,4)}}

  /* Steps */
  .steps{list-style:none;margin:0;padding:0;display:grid;gap:40px;position:relative}
  @media(min-width:760px){.steps{grid-template-columns:repeat(auto-fit,minmax(0,1fr))}.steps li:not(:last-child)::after{content:"";position:absolute;top:28px;left:76px;right:-20px;height:2px;background:color-mix(in srgb,var(--c-text) 18%,transparent)}}
  .steps li{position:relative;display:flex;flex-direction:column;gap:10px;padding-right:16px}
  .step-n{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;background:var(--c-accent);color:var(--c-on-accent);font-family:var(--f-head);font-weight:800;font-size:22px;margin-bottom:12px;box-shadow:0 0 0 8px var(--c-bg)}

  /* Why */
  .why{position:relative;background:var(--c-panel)}
  .why.has-photo{min-height:720px;display:flex;align-items:center}
  .why-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .why-row{position:relative;z-index:1;display:flex;justify-content:flex-end;width:100%;padding-block:clamp(64px,9vw,112px)}
  .why-card{background:var(--c-bg);border-radius:var(--radius);padding:clamp(28px,4vw,48px);max-width:520px;display:flex;flex-direction:column;gap:28px;box-shadow:0 30px 60px -30px rgb(0 0 0/.45)}
  .why:not(.has-photo) .why-row{justify-content:flex-start}
  .why:not(.has-photo) .why-card{box-shadow:none;max-width:none;width:100%}
  .why-card ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:22px}
  .why-card li{display:flex;gap:16px}
  .why-card li div{display:flex;flex-direction:column;gap:4px}
  .why-ic{flex:none;width:44px;height:44px;border-radius:var(--radius);display:grid;place-items:center;background:color-mix(in srgb,var(--c-accent) 22%,var(--c-bg));color:var(--c-accent-text)}
  @media(max-width:760px){.why.has-photo{display:block;min-height:0;padding-top:300px}.why-img{height:340px}.why-row{padding-block:0 48px}}

  /* Reviews */
  .reviews{display:grid;gap:40px}
  @media(min-width:860px){.reviews{grid-template-columns:1.3fr 1fr;align-items:center}}
  .reviews blockquote{margin:0}
  .review-main{display:flex;flex-direction:column;gap:20px;color:var(--c-accent-text)}
  .review-main p{font-family:var(--f-head);font-size:clamp(22px,3vw,32px);line-height:1.25;color:var(--c-text);letter-spacing:-.01em}
  .review-main footer,.review-side footer{font-weight:600;font-size:var(--t-small);color:var(--c-text)}
  .review-side{display:flex;flex-direction:column;gap:24px}
  .review-side blockquote{border-left:3px solid var(--c-accent);padding-left:20px;display:flex;flex-direction:column;gap:8px}

  /* FAQs */
  .faq-row{display:grid;gap:40px}
  @media(min-width:860px){.faq-row{grid-template-columns:1fr 1.6fr}.faq-side{position:sticky;top:110px;align-self:start}}
  .faq-side{display:flex;flex-direction:column;gap:24px}
  .areas{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .areas li{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:999px;background:var(--c-panel);font-weight:600;font-size:15px}
  .faq-list details{border-top:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .faq-list details:last-child{border-bottom:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .faq-list summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;padding-block:22px;font-family:var(--f-head);font-weight:700;font-size:19px;cursor:pointer}
  .faq-list summary::-webkit-details-marker{display:none}
  .faq-list summary :global(svg){flex:none;transition:transform .25s}
  .faq-list details[open] summary :global(svg){transform:rotate(180deg)}
  .faq-list details p{padding-bottom:22px;max-width:60ch}
</style>
