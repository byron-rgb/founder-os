---
// Trades template (Founder OS): electricians, plumbers, builders, painters and other call-out trades.
// Content comes from src/content/site.json, colours and fonts from the founder's design system.
// Built around the two things a trade customer wants to know fast: can you come, and can I trust you.
// Sections with no content are hidden. Photos: the founder's own, in public/images/, any left null is skipped.
import Site from '../layouts/Site.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';
const { hero, credentials = [], emergency, services = [], gallery = [], steps = [], team, why = [], reviews = [], rating, faqs = [], business: b } = site;
const tel = b.phone ? `tel:${b.phone.replace(/\s/g, '')}` : null;
const areas = b.serviceAreas || [];
const [lead, ...moreReviews] = reviews;
---
<Site overlay={true}>
  <!-- Hero: solid panel with the message and the phone, the work photo beside it -->
  <section class:list={['th-hero', { 'no-photo': !hero.image }]}>
    <div class="th-hero-panel">
      <div class="th-hero-copy">
        {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
        <h1>{hero.title}</h1>
        <p class="lead">{hero.text}</p>
        <div class="th-hero-ctas">
          {tel && <a class="btn" href={tel}><Icon name="phone" size={18} />Call {b.phone}</a>}
          <a class:list={['btn', { ghost: !!tel }]} href="#quote">{site.cta}</a>
        </div>
      </div>
    </div>
    {hero.image && <div class="th-hero-photo"><img src={hero.image} alt={hero.imageAlt || ''} fetchpriority="high" /></div>}
  </section>

  <!-- Credentials: licence, insurance, response time -->
  {credentials.length > 0 && <section class="th-creds" aria-label="Licensed and insured">
    <ul class="wrap">{credentials.map((c) => <li><strong>{c.value}</strong><span>{c.label}</span></li>)}</ul>
  </section>}

  <!-- Services: intro and the urgent-job card on the left, every job type on the right -->
  {services.length > 0 && <section class="section" id="services">
    <div class="wrap th-svc">
      <div class="th-svc-side">
        <h2>{site.servicesTitle || 'What we fix and fit'}</h2>
        {site.servicesText && <p class="muted">{site.servicesText}</p>}
        {emergency && <div class="th-urgent">
          <span class="th-urgent-ic"><Icon name="siren" size={22} /></span>
          <h3>{emergency.title}</h3>
          {emergency.text && <p>{emergency.text}</p>}
          {tel && <a class="th-urgent-call" href={tel}><Icon name="phone" size={18} />{b.phone}</a>}
        </div>}
      </div>
      <ul class="th-svc-list">
        {services.map((s) => <li class="reveal">
          <span class="th-svc-ic"><Icon name={s.icon || 'wrench'} size={22} /></span>
          <div><h3>{s.name}</h3><p class="muted">{s.text}</p></div>
          {s.from && <strong>{s.from}</strong>}
        </li>)}
      </ul>
    </div>
  </section>}

  <!-- Recent jobs: a row you swipe or scroll -->
  {gallery.length > 0 && <section class="section panel th-work" id="work">
    <div class="wrap th-work-head">
      <h2>{site.workTitle || 'Recent jobs'}</h2>
      {gallery.length > 2 && <div class="th-work-nav">
        <button type="button" data-dir="-1" aria-label="Previous jobs"><Icon name="arrow-left" size={20} /></button>
        <button type="button" data-dir="1" aria-label="More jobs"><Icon name="arrow-right" size={20} /></button>
      </div>}
    </div>
    <ul class="th-work-row" tabindex="0" aria-label="Recent jobs">
      {gallery.map((g) => <li>
        <div class="photo">{g.src ? <img src={g.src} alt={g.label} loading="lazy" /> : <span class="muted">Photo: {g.label}</span>}</div>
        <p class="th-work-title">{g.label}</p>
        {(g.suburb || g.text) && <p class="muted th-work-meta">{[g.suburb, g.text].filter(Boolean).join('. ')}</p>}
      </li>)}
    </ul>
  </section>}

  <!-- How a job runs -->
  {steps.length > 0 && <section class="section" id="process">
    <div class="wrap">
      <h2 class="th-h2">{site.stepsTitle || 'How a job runs'}</h2>
      <ol class="th-steps">{steps.map((s, i) => <li class="reveal"><span class="th-step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{s.title}</h3><p class="muted">{s.text}</p></li>)}</ol>
    </div>
  </section>}

  <!-- Who turns up: the owner's photo and what they promise -->
  {why.length > 0 && <section class="section panel" id="about">
    <div class:list={['wrap th-about', { 'has-photo': team?.image }]}>
      {team?.image && <figure class="th-about-photo">
        <img src={team.image} alt={team.alt || ''} loading="lazy" />
        {(team.name || team.role) && <figcaption><strong>{team.name}</strong>{team.role && <span>{team.role}</span>}</figcaption>}
      </figure>}
      <div class="th-about-copy">
        <h2>{site.whyTitle || 'Who turns up'}</h2>
        {team?.note && <p class="lead">{team.note}</p>}
        <ul class="th-why">{why.map((w) => <li><span class="th-why-ic"><Icon name={w.icon || 'seal-check'} size={20} /></span><div><h3>{w.title}</h3><p class="muted">{w.text}</p></div></li>)}</ul>
      </div>
    </div>
  </section>}

  <!-- Reviews: only real ones, never examples -->
  {reviews.length > 0 && <section class="section" id="reviews">
    <div class="wrap th-reviews">
      <div class="th-review-lead reveal">
        {rating?.score && <p class="th-rating"><span class="th-stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" weight="fill" size={20} />)}</span>{rating.score}{rating.count && ` from ${rating.count} reviews`}{rating.source && ` on ${rating.source}`}</p>}
        <blockquote><p>{lead.quote}</p><footer>{lead.name}{lead.suburb && `, ${lead.suburb}`}</footer></blockquote>
      </div>
      {moreReviews.length > 0 && <div class="th-review-more">{moreReviews.slice(0, 4).map((r) => <blockquote class="reveal"><p>{r.quote}</p><footer>{r.name}{r.suburb && `, ${r.suburb}`}</footer></blockquote>)}</div>}
    </div>
  </section>}

  <!-- Where we work -->
  {areas.length > 0 && <section class="section panel th-areas" id="areas">
    <div class="wrap">
      <p class="th-areas-label"><Icon name="map-pin" size={18} />{site.areasTitle || 'Where we work'}</p>
      <p class="th-areas-list">{areas.map((a, i) => <><span>{a}</span>{i < areas.length - 1 && <span class="th-sep" aria-hidden="true">/</span>}</>)}</p>
      {tel && <p class="muted">Close by but not listed? <a href={tel}><strong>Call {b.phone}</strong></a></p>}
    </div>
  </section>}

  <!-- FAQs -->
  {faqs.length > 0 && <section class="section" id="faqs">
    <div class="wrap th-faq">
      <h2>{site.faqTitle || 'Good to know'}</h2>
      <div>{faqs.map((f) => <details><summary>{f.q}<span class="th-plus" aria-hidden="true"></span></summary><p class="muted">{f.a}</p></details>)}</div>
    </div>
  </section>}

  <QuoteForm />
</Site>

<script>
  // Recent jobs row: the arrow buttons scroll by one card.
  document.querySelectorAll('.th-work').forEach((sec) => {
    const row = sec.querySelector('.th-work-row') as HTMLElement | null;
    sec.querySelectorAll<HTMLButtonElement>('.th-work-nav button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = row?.querySelector('li');
        if (!row || !card) return;
        row.scrollBy({ left: Number(btn.dataset.dir) * (card.getBoundingClientRect().width + 20), behavior: 'smooth' });
      });
    });
  });
</script>

<style>
  /* Hero */
  .th-hero{display:grid;min-height:min(90dvh,860px);background:var(--c-text);color:var(--c-bg)}
  @media(min-width:900px){.th-hero{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)}.th-hero.no-photo{grid-template-columns:1fr}}
  .th-hero-panel{display:flex;align-items:flex-end;padding:120px max(20px,env(safe-area-inset-left,0px)) clamp(48px,7vw,88px)}
  @media(min-width:900px){.th-hero-panel{padding-left:max(20px,calc((100vw - 1200px) / 2 + 20px));padding-right:56px}}
  .th-hero-copy{display:flex;flex-direction:column;gap:22px;max-width:600px}
  .th-hero h1{font-size:clamp(44px,6.2vw,calc(var(--t-h1) * 1.85));line-height:.98;text-transform:uppercase;letter-spacing:-.01em}
  .th-hero .eyebrow{color:color-mix(in srgb,var(--c-accent) 55%,var(--c-bg))}
  .th-hero.no-photo .th-hero-copy{max-width:860px}
  .th-hero .lead{opacity:.85}
  .th-hero-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:6px}
  .th-hero-ctas .ghost{color:var(--c-bg)}
  .th-hero-photo{position:relative;min-height:300px}
  .th-hero-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .th-hero-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgb(10 10 10/.78),rgb(10 10 10/.25) 22%,transparent 40%)}
  @media(max-width:899px){.th-hero-photo{order:-1;min-height:min(46vh,420px)}.th-hero-panel{padding-top:40px}}
  @media (prefers-reduced-motion:no-preference){.th-hero-copy > *{animation:th-in .8s cubic-bezier(.16,1,.3,1) both}.th-hero-copy > :nth-child(2){animation-delay:.06s}.th-hero-copy > :nth-child(3){animation-delay:.12s}.th-hero-copy > :nth-child(4){animation-delay:.18s}}
  @keyframes th-in{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}

  /* Credentials strip */
  .th-creds{background:var(--c-panel);border-bottom:1px solid color-mix(in srgb,var(--c-text) 10%,transparent)}
  .th-creds ul{list-style:none;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
  .th-creds li{display:flex;flex-direction:column;gap:2px;padding:26px 24px 26px 0}
  @media(min-width:760px){.th-creds li + li{padding-left:28px;border-left:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}}
  .th-creds strong{font-family:var(--f-head);font-size:clamp(24px,2.6vw,30px);line-height:1.1;text-transform:uppercase}
  .th-creds span{font-size:var(--t-small);opacity:.7}

  /* Services */
  .th-svc{display:grid;gap:40px}
  @media(min-width:900px){.th-svc{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:72px}.th-svc-side{position:sticky;top:110px;align-self:start}}
  .th-svc-side{display:flex;flex-direction:column;gap:16px}
  .th-svc h2,.th-h2,.th-about h2,.th-faq h2,.th-work h2{text-transform:uppercase;font-size:clamp(30px,4vw,calc(var(--t-h2) * 1.6));line-height:1}
  .th-urgent{margin-top:16px;background:var(--c-accent);color:var(--c-on-accent);border-radius:var(--radius);padding:28px;display:flex;flex-direction:column;gap:10px}
  .th-urgent h3{font-size:24px;text-transform:uppercase}
  .th-urgent-ic{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:color-mix(in srgb,var(--c-on-accent) 12%,transparent)}
  .th-urgent-call{display:inline-flex;align-items:center;gap:10px;margin-top:8px;font-family:var(--f-head);font-weight:700;font-size:28px;text-decoration:none}
  .th-svc-list{list-style:none;margin:0;padding:0}
  .th-svc-list li{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:20px;align-items:start;padding:24px 0;border-top:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .th-svc-list li:last-child{border-bottom:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .th-svc-list li div{display:flex;flex-direction:column;gap:6px}
  .th-svc-list h3{font-size:21px}
  .th-svc-list strong{white-space:nowrap;font-size:15px;padding-top:3px}
  .th-svc-ic{width:48px;height:48px;border-radius:var(--radius);display:grid;place-items:center;background:var(--c-text);color:var(--c-accent)}
  @media(max-width:560px){.th-svc-list li{grid-template-columns:40px minmax(0,1fr);gap:16px}.th-svc-list strong{grid-column:2}.th-svc-ic{width:40px;height:40px}}

  /* Recent jobs row */
  .th-work-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:32px}
  .th-work-nav{display:flex;gap:8px}
  .th-work-nav button{width:48px;height:48px;border-radius:50%;border:1.5px solid color-mix(in srgb,var(--c-text) 30%,transparent);background:transparent;color:var(--c-text);display:grid;place-items:center;cursor:pointer;transition:background .2s}
  .th-work-nav button:hover{background:var(--c-bg)}
  .th-work-row{list-style:none;margin:0;display:grid;grid-auto-flow:column;grid-auto-columns:min(78vw,380px);gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:max(20px,calc((100vw - 1200px) / 2 + 20px));padding:0 max(20px,calc((100vw - 1200px) / 2 + 20px)) 12px;scrollbar-width:none}
  .th-work-row::-webkit-scrollbar{display:none}
  .th-work-row li{scroll-snap-align:start;display:flex;flex-direction:column;gap:6px}
  .th-work-row .photo{aspect-ratio:4/5;margin-bottom:8px}
  .th-work-title{font-family:var(--f-head);font-weight:700;font-size:20px;text-transform:uppercase}
  .th-work-meta{font-size:var(--t-small)}

  /* Steps */
  .th-h2{margin-bottom:clamp(32px,5vw,56px)}
  .th-steps{list-style:none;margin:0;padding:0;display:grid;gap:36px}
  @media(min-width:760px){.th-steps{grid-template-columns:repeat(auto-fit,minmax(0,1fr));gap:40px}}
  .th-steps li{display:flex;flex-direction:column;gap:10px;padding-top:20px;border-top:3px solid var(--c-text)}
  .th-steps li:first-child{border-top-color:var(--c-accent)}
  .th-step-n{font-family:var(--f-head);font-weight:800;font-size:64px;line-height:.9;color:transparent;-webkit-text-stroke:1.5px var(--c-text)}
  .th-steps h3{font-size:21px}

  /* Who turns up */
  .th-about{display:grid;gap:40px;align-items:center}
  @media(min-width:900px){.th-about.has-photo{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:72px}}
  .th-about-photo{margin:0;position:relative;border-radius:var(--radius);overflow:hidden;aspect-ratio:4/5;background:var(--c-text)}
  .th-about-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .th-about-photo figcaption{position:absolute;left:16px;bottom:16px;background:var(--c-bg);color:var(--c-text);border-radius:var(--radius);padding:12px 16px;display:flex;flex-direction:column;line-height:1.3}
  .th-about-photo figcaption span{font-size:var(--t-small);opacity:.7}
  .th-about-copy{display:flex;flex-direction:column;gap:20px}
  .th-why{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:24px}
  @media(min-width:600px){.th-why{grid-template-columns:1fr 1fr}}
  .th-why li{display:flex;gap:14px}
  .th-why li div{display:flex;flex-direction:column;gap:4px}
  .th-why h3{font-size:18px}
  .th-why-ic{flex:none;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--c-accent);color:var(--c-on-accent)}

  /* Reviews */
  .th-reviews{display:grid;gap:48px}
  @media(min-width:900px){.th-reviews{grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:72px;align-items:center}}
  .th-reviews blockquote{margin:0}
  .th-rating{display:flex;flex-wrap:wrap;align-items:center;gap:10px;font-weight:600;margin-bottom:20px}
  .th-stars{display:inline-flex;gap:2px;color:var(--c-accent)}
  .th-review-lead blockquote p{font-family:var(--f-head);font-size:clamp(26px,3.2vw,38px);line-height:1.15;font-weight:700}
  .th-review-lead footer,.th-review-more footer{margin-top:14px;font-weight:600;font-size:var(--t-small)}
  .th-review-more{display:flex;flex-direction:column;gap:28px}
  .th-review-more blockquote{padding-left:20px;border-left:3px solid var(--c-accent)}

  /* Areas */
  .th-areas{padding-block:clamp(56px,7vw,88px)}
  .th-areas .wrap{display:flex;flex-direction:column;gap:18px}
  .th-areas-label{display:inline-flex;align-items:center;gap:8px;font-weight:700;color:var(--c-accent-text)}
  .th-areas-list{font-family:var(--f-head);font-weight:800;text-transform:uppercase;font-size:clamp(32px,6vw,72px);line-height:1.02;letter-spacing:-.01em;display:flex;flex-wrap:wrap;column-gap:.35em}
  .th-sep{color:var(--c-accent)}

  /* FAQs */
  .th-faq{display:grid;gap:32px}
  @media(min-width:900px){.th-faq{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:72px}}
  .th-faq details{border-top:1px solid color-mix(in srgb,var(--c-text) 16%,transparent)}
  .th-faq details:last-child{border-bottom:1px solid color-mix(in srgb,var(--c-text) 16%,transparent)}
  .th-faq summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0;font-weight:700;font-size:18px;cursor:pointer}
  .th-faq summary::-webkit-details-marker{display:none}
  .th-plus{flex:none;position:relative;width:16px;height:16px}
  .th-plus::before,.th-plus::after{content:"";position:absolute;left:0;top:7px;width:16px;height:2px;background:currentColor;transition:transform .25s}
  .th-plus::after{transform:rotate(90deg)}
  .th-faq details[open] .th-plus::after{transform:rotate(0)}
  .th-faq details p{padding-bottom:22px;max-width:62ch}
</style>

<style is:global>
  /* The shared quote form, in this template's heading style */
  #quote h2{text-transform:uppercase;font-size:clamp(30px,4vw,calc(var(--t-h2) * 1.6));line-height:1}
</style>
