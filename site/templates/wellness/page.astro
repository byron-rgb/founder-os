---
// Health and wellness template (Founder OS): physio and allied health clinics, personal trainers, gyms,
// pilates and wellness studios. Booking is the main action: set site.bookingUrl to their booking system
// (Cliniko, Mindbody, Fresha, Calendly...) and every "Book" button goes there; leave it null and the
// enquiry form at the bottom takes bookings. Content comes from src/content/site.json, colours and fonts
// from the founder's design system. Sections with no content are hidden. Photos: the founder's own, in
// public/images/. No medical claims in the copy: say what you help with, not what you cure.
import Site from '../layouts/Site.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';
const {
  hero, business: b, helpWith = [], services = [], firstVisit, team = [], pricing = [], reviews = [], location, faqs = [],
} = site;
const tel = b.phone ? `tel:${b.phone.replace(/\s/g, '')}` : null;
const booking = site.bookingUrl || null;
const bookHref = booking || '#quote';
const bookAttrs = booking ? { target: '_blank', rel: 'noopener' } : {};
const lead = services.find((s) => s.image) || null;
const steps = firstVisit?.steps || [];
const hours = location?.hours || [];
const mapHref = location?.mapUrl || (location?.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.address)}` : null);
---
<Site>
  <!-- Hero: one promise, one booking button, a calm photo in an arch -->
  <section class="w-hero">
    <div class="wrap w-hero-row">
      <div class="w-hero-copy">
        {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
        <h1>{hero.title}</h1>
        <p class="lead">{hero.text}</p>
        <div class="w-ctas">
          <a class="btn" href={bookHref} {...bookAttrs}><Icon name="calendar-check" size={18} />{site.cta}</a>
          {tel && <a class="btn ghost" href={tel}><Icon name="phone" size={18} />{b.phone}</a>}
        </div>
      </div>
      <div class="w-hero-media">
        <div class="w-arch">
          {hero.image ? <img src={hero.image} alt={hero.imageAlt || ''} fetchpriority="high" /> : <span class="muted">Your studio or a session in progress</span>}
        </div>
        {hero.note && <div class="w-note">
          <span class="w-note-ic"><Icon name="heartbeat" size={20} /></span>
          <div><strong>{hero.note.title}</strong><p>{hero.note.text}</p></div>
        </div>}
      </div>
    </div>
  </section>

  <!-- What we help with -->
  {helpWith.length > 0 && <section class="section w-help" id="help">
    <div class="wrap w-help-row">
      <div class="reveal">
        <h2>{site.helpTitle || 'What we help with'}</h2>
        {site.helpText && <p class="lead muted">{site.helpText}</p>}
      </div>
      <ul class="w-chips reveal">{helpWith.map((h) => <li>{h}</li>)}</ul>
    </div>
  </section>}

  <!-- Services as a menu: photo on one side, the list with times and prices on the other -->
  {services.length > 0 && <section class="section panel" id="services">
    <div class="wrap w-menu">
      {lead && <div class="w-menu-photo reveal"><img src={lead.image} alt="" loading="lazy" /></div>}
      <div class:list={['w-menu-list', { full: !lead }]}>
        <h2 class="reveal">{site.servicesTitle || 'Ways we work with you'}</h2>
        <ul>
          {services.map((s) => <li class="reveal">
            <div class="w-menu-main">
              <h3>{s.name}</h3>
              {s.text && <p class="muted">{s.text}</p>}
            </div>
            <div class="w-menu-meta">
              {s.length && <span><Icon name="clock" size={16} />{s.length}</span>}
              {s.price && <strong>{s.price}</strong>}
            </div>
          </li>)}
        </ul>
        <a class="w-text-link" href={bookHref} {...bookAttrs}>{site.cta}<Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </section>}

  <!-- Your first visit -->
  {steps.length > 0 && <section class="section" id="first-visit">
    <div class="wrap">
      <div class="w-visit-head reveal">
        <h2>{firstVisit.title || 'Your first visit'}</h2>
        {firstVisit.text && <p class="lead muted">{firstVisit.text}</p>}
      </div>
      <ol class="w-visit">
        {steps.map((s, i) => <li class="reveal">
          <span class="w-visit-n">{String(i + 1).padStart(2, '0')}</span>
          <div><h3>{s.title}</h3><p class="muted">{s.text}</p></div>
        </li>)}
      </ol>
    </div>
  </section>}

  <!-- The team -->
  {team.length > 0 && <section class="section panel" id="team">
    <div class="wrap">
      <h2 class="w-center reveal">{site.teamTitle || 'Who you will see'}</h2>
      <ul class:list={['w-team', `n${Math.min(team.length, 4)}`]}>
        {team.map((p) => <li class="reveal">
          <div class="w-portrait">{p.photo ? <img src={p.photo} alt={p.name} loading="lazy" /> : <span class="w-initials">{p.name.split(' ').map((w) => w[0]).join('').slice(0, 2)}</span>}</div>
          <h3>{p.name}</h3>
          {p.role && <p class="w-role">{p.role}</p>}
          {p.bio && <p class="muted w-bio">{p.bio}</p>}
        </li>)}
      </ul>
    </div>
  </section>}

  <!-- Prices -->
  {pricing.length > 0 && <section class="section" id="prices">
    <div class="wrap">
      <div class="w-visit-head reveal">
        <h2>{site.pricingTitle || 'Prices'}</h2>
        {site.pricingText && <p class="lead muted">{site.pricingText}</p>}
      </div>
      <div class="w-prices">
        {pricing.map((p) => <article class:list={['w-price reveal', { featured: p.featured }]}>
          {p.featured && <span class="w-badge">{p.badge || 'Most popular'}</span>}
          <h3>{p.name}</h3>
          <p class="w-amount"><strong>{p.price}</strong>{p.per && <span>{p.per}</span>}</p>
          {p.text && <p class="muted">{p.text}</p>}
          {p.includes?.length > 0 && <ul>{p.includes.map((x) => <li><Icon name="check-circle" size={18} weight="fill" />{x}</li>)}</ul>}
          <a class:list={['btn', { ghost: !p.featured }]} href={bookHref} {...bookAttrs}>{p.cta || site.cta}</a>
        </article>)}
      </div>
      {site.pricingNote && <p class="w-fund"><Icon name="first-aid-kit" size={20} />{site.pricingNote}</p>}
    </div>
  </section>}

  <!-- Reviews: only real ones, never examples -->
  {reviews.length > 0 && <section class="w-reviews" id="reviews">
    <div class="wrap w-reviews-row">
      <blockquote class="reveal">
        <Icon name="quotes" size={40} weight="fill" />
        <p>{reviews[0].quote}</p>
        <footer>{reviews[0].name}{reviews[0].suburb && `, ${reviews[0].suburb}`}</footer>
      </blockquote>
      {reviews.length > 1 && <ul class="w-reviews-more">
        {reviews.slice(1, 4).map((r) => <li class="reveal"><p>{r.quote}</p><span>{r.name}{r.suburb && `, ${r.suburb}`}</span></li>)}
      </ul>}
    </div>
  </section>}

  <!-- Where and when -->
  {location && (location.address || hours.length > 0) && <section class="section panel" id="visit">
    <div class="wrap w-where">
      <div class="w-where-card reveal">
        <h2>{location.title || 'Find us'}</h2>
        {location.address && <p class="w-addr"><Icon name="map-pin" size={20} />{location.address}</p>}
        {location.parking && <p class="w-addr muted"><Icon name="car" size={20} />{location.parking}</p>}
        {hours.length > 0 && <dl class="w-hours">{hours.map((h) => <div><dt>{h.days}</dt><dd>{h.time}</dd></div>)}</dl>}
        <div class="w-ctas">
          <a class="btn" href={bookHref} {...bookAttrs}><Icon name="calendar-check" size={18} />{site.cta}</a>
          {mapHref && <a class="btn ghost" href={mapHref} target="_blank" rel="noopener">Directions<Icon name="arrow-up-right" size={16} /></a>}
        </div>
      </div>
      <div class="w-where-photo reveal">{location.image ? <img src={location.image} alt={location.imageAlt || ''} loading="lazy" /> : <span class="muted">A photo of your front door or reception</span>}</div>
    </div>
  </section>}

  <!-- FAQs -->
  {faqs.length > 0 && <section class="section" id="faqs">
    <div class="wrap w-faq">
      <h2 class="w-center reveal">Good to know</h2>
      <div>{faqs.map((f) => <details class="reveal"><summary>{f.q}<Icon name="caret-down" size={20} /></summary><p class="muted">{f.a}</p></details>)}</div>
    </div>
  </section>}

  <!-- Booking: their booking system if they have one, otherwise the enquiry form -->
  {booking ? (
    <section class="section" id="quote">
      <div class="wrap w-book reveal">
        <h2>{site.bookTitle || 'Book your first session'}</h2>
        <p class="lead">{site.bookText || 'Pick a time that suits you. It takes about a minute.'}</p>
        <div class="w-ctas">
          <a class="btn" href={booking} target="_blank" rel="noopener"><Icon name="calendar-check" size={18} />{site.cta}</a>
          {tel && <a class="btn ghost" href={tel}><Icon name="phone" size={18} />{b.phone}</a>}
        </div>
      </div>
    </section>
  ) : (
    <QuoteForm title={site.bookTitle || 'Book your first session'} text={site.bookText || 'Tell us a little about you and we will find a time that suits.'} />
  )}
</Site>

<style>
  /* Hero */
  .w-hero{padding-block:clamp(32px,5vw,72px) clamp(48px,6vw,72px);background:linear-gradient(180deg,var(--c-panel),var(--c-bg) 85%)}
  .w-hero-row{display:grid;gap:clamp(32px,5vw,72px);align-items:center}
  @media(min-width:900px){.w-hero-row{grid-template-columns:1.05fr .95fr}}
  .w-hero-copy{display:flex;flex-direction:column;gap:20px}
  .w-hero .eyebrow{color:var(--c-accent-text)}
  .w-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:6px}
  .w-hero-media{position:relative;max-width:520px;width:100%;justify-self:center}
  .w-arch{aspect-ratio:4/5;border-radius:999px 999px var(--radius) var(--radius);overflow:hidden;position:relative;background:color-mix(in srgb,var(--c-accent) 14%,var(--c-panel));display:grid;place-items:center;text-align:center;padding:24px;font-size:var(--t-small)}
  .w-arch img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .w-note{position:absolute;left:-28px;bottom:36px;display:flex;gap:12px;align-items:flex-start;max-width:290px;padding:16px 18px;border-radius:calc(var(--radius) + 6px);background:var(--c-bg);box-shadow:0 24px 50px -24px color-mix(in srgb,var(--c-text) 55%,transparent)}
  .w-note strong{display:block;font-size:15px}
  .w-note p{font-size:var(--t-small);opacity:.75;margin-top:2px}
  .w-note-ic{flex:none;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--c-accent);color:var(--c-on-accent)}
  @media(max-width:899px){.w-hero-media{max-width:420px}.w-arch{aspect-ratio:1/1}.w-note{left:12px;right:12px;bottom:-24px;max-width:none}}
  @media (prefers-reduced-motion:no-preference){.w-hero-copy > *,.w-hero-media{animation:w-in .9s cubic-bezier(.16,1,.3,1) both}.w-hero-copy > :nth-child(2){animation-delay:.06s}.w-hero-copy > :nth-child(3){animation-delay:.12s}.w-hero-copy > :nth-child(4){animation-delay:.18s}.w-hero-media{animation-delay:.1s}}
  @keyframes w-in{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}

  /* What we help with */
  .w-help-row{display:grid;gap:32px;align-items:center}
  @media(min-width:900px){.w-help-row{grid-template-columns:1fr 1.2fr;gap:72px}}
  .w-help-row > div{display:flex;flex-direction:column;gap:14px}
  .w-chips{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
  .w-chips li{padding:12px 18px;border-radius:999px;background:var(--c-panel);border:1px solid color-mix(in srgb,var(--c-text) 10%,transparent);font-weight:600;font-size:15px}

  /* Services menu */
  .w-menu{display:grid;gap:clamp(32px,5vw,64px);align-items:start}
  @media(min-width:900px){.w-menu{grid-template-columns:.9fr 1.1fr}.w-menu-photo{position:sticky;top:104px}}
  .w-menu-photo{border-radius:var(--radius);overflow:hidden;aspect-ratio:4/5;position:relative}
  .w-menu-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  @media(max-width:899px){.w-menu-photo{aspect-ratio:16/10}}
  .w-menu-list{display:flex;flex-direction:column;gap:12px}
  .w-menu-list ul{list-style:none;margin:16px 0 8px;padding:0}
  .w-menu-list li{display:flex;justify-content:space-between;gap:24px;padding-block:22px;border-top:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .w-menu-list li:last-child{border-bottom:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .w-menu-main{display:flex;flex-direction:column;gap:6px;max-width:44ch}
  .w-menu-main h3{font-size:20px}
  .w-menu-meta{display:flex;flex-direction:column;align-items:flex-end;gap:6px;text-align:right;white-space:nowrap;padding-top:3px}
  .w-menu-meta span{display:inline-flex;align-items:center;gap:6px;font-size:var(--t-small);opacity:.75}
  .w-menu-meta strong{font-size:17px}
  .w-text-link{display:inline-flex;align-items:center;gap:8px;font-weight:700;color:var(--c-accent-text);text-decoration:none;align-self:flex-start;padding-block:6px}
  .w-text-link:hover{text-decoration:underline;text-underline-offset:5px}
  @media(max-width:520px){.w-menu-list li{flex-direction:column;gap:10px}.w-menu-meta{flex-direction:row;align-items:center;gap:16px}}

  /* First visit */
  .w-visit-head{display:flex;flex-direction:column;gap:12px;max-width:640px;margin-bottom:clamp(32px,5vw,56px)}
  .w-visit{list-style:none;margin:0;padding:0;display:grid;gap:16px}
  @media(min-width:760px){.w-visit{grid-template-columns:repeat(auto-fit,minmax(0,1fr))}}
  .w-visit li{display:flex;flex-direction:column;gap:18px;padding:28px;border-radius:calc(var(--radius) + 8px);background:var(--c-panel)}
  .w-visit li div{display:flex;flex-direction:column;gap:8px}
  .w-visit li:nth-child(even){background:color-mix(in srgb,var(--c-accent) 12%,var(--c-panel))}
  .w-visit-n{font-family:var(--f-head);font-size:44px;font-weight:600;line-height:1;color:var(--c-accent-text);letter-spacing:-.03em}

  /* Team */
  .w-center{text-align:center;margin-bottom:clamp(32px,5vw,56px)}
  .w-team{list-style:none;margin:0 auto;padding:0;display:grid;gap:40px 28px;max-width:1040px}
  .w-team.n1{grid-template-columns:minmax(0,320px);justify-content:center}
  @media(max-width:639px){.w-team:not(.n1){display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:20px;margin-inline:-20px;padding:4px 20px 12px;scrollbar-width:none}.w-team:not(.n1)::-webkit-scrollbar{display:none}.w-team:not(.n1) li{flex:0 0 72%;scroll-snap-align:center}}
  @media(min-width:640px){.w-team.n2,.w-team.n3,.w-team.n4{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(min-width:960px){.w-team.n3{grid-template-columns:repeat(3,minmax(0,1fr))}.w-team.n4{grid-template-columns:repeat(4,minmax(0,1fr))}.w-team.n2{max-width:720px}}
  .w-team li{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px}
  .w-portrait{width:100%;max-width:240px;aspect-ratio:4/5;border-radius:999px 999px var(--radius) var(--radius);overflow:hidden;position:relative;margin-bottom:14px;background:color-mix(in srgb,var(--c-accent) 16%,var(--c-bg));display:grid;place-items:center}
  .w-portrait img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .w-initials{font-family:var(--f-head);font-size:48px;color:var(--c-accent-text)}
  .w-role{font-weight:600;color:var(--c-accent-text);font-size:15px}
  .w-bio{font-size:15px;max-width:30ch}

  /* Prices */
  .w-prices{display:grid;gap:20px;align-items:stretch}
  @media(min-width:760px){.w-prices{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}}
  .w-price{position:relative;display:flex;flex-direction:column;gap:14px;padding:32px 28px;border-radius:calc(var(--radius) + 8px);border:1px solid color-mix(in srgb,var(--c-text) 14%,transparent);background:var(--c-bg)}
  .w-price.featured{border:2px solid var(--c-accent);box-shadow:0 30px 60px -36px color-mix(in srgb,var(--c-accent) 70%,transparent)}
  .w-badge{position:absolute;top:-13px;left:28px;background:var(--c-accent);color:var(--c-on-accent);font-size:13px;font-weight:700;padding:4px 12px;border-radius:999px}
  .w-amount{display:flex;align-items:baseline;gap:8px}
  .w-amount strong{font-family:var(--f-head);font-size:clamp(32px,4vw,40px);letter-spacing:-.02em;line-height:1}
  .w-amount span{opacity:.7;font-size:15px}
  .w-price ul{list-style:none;margin:4px 0 8px;padding:0;display:flex;flex-direction:column;gap:10px;font-size:15px}
  .w-price li{display:flex;gap:10px;align-items:flex-start}
  .w-price li :global(svg){flex:none;color:var(--c-accent-text);margin-top:2px}
  .w-price .btn{margin-top:auto}
  .w-fund{display:flex;gap:12px;align-items:center;margin-top:28px;padding:16px 20px;border-radius:var(--radius);background:var(--c-panel);font-size:15px}
  .w-fund :global(svg){flex:none;color:var(--c-accent-text)}

  /* Reviews: one colour band */
  .w-reviews{background:var(--c-accent);color:var(--c-on-accent);padding-block:clamp(64px,9vw,112px)}
  .w-reviews-row{display:grid;gap:48px;align-items:center}
  @media(min-width:900px){.w-reviews-row{grid-template-columns:1.35fr 1fr;gap:80px}}
  .w-reviews blockquote{margin:0;display:flex;flex-direction:column;gap:22px}
  .w-reviews blockquote :global(svg){opacity:.55}
  .w-reviews blockquote p{font-family:var(--f-head);font-size:clamp(24px,3.2vw,34px);line-height:1.25;letter-spacing:-.01em}
  .w-reviews footer,.w-reviews-more span{font-weight:700;font-size:15px;opacity:.85}
  .w-reviews-more{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:28px}
  .w-reviews-more li{display:flex;flex-direction:column;gap:8px;padding-left:20px;border-left:2px solid color-mix(in srgb,var(--c-on-accent) 45%,transparent)}

  /* Where and when */
  .w-where{display:grid;gap:24px;align-items:stretch}
  @media(min-width:900px){.w-where{grid-template-columns:1fr 1fr}}
  .w-where-card{display:flex;flex-direction:column;gap:18px;padding:clamp(28px,4vw,48px);border-radius:calc(var(--radius) + 8px);background:var(--c-bg)}
  .w-addr{display:flex;gap:10px;align-items:flex-start;font-weight:600}
  .w-addr :global(svg){flex:none;margin-top:3px;color:var(--c-accent-text)}
  .w-hours{margin:4px 0 0;display:flex;flex-direction:column}
  .w-hours div{display:flex;justify-content:space-between;gap:16px;padding-block:10px;border-bottom:1px solid color-mix(in srgb,var(--c-text) 12%,transparent)}
  .w-hours dt{font-weight:600}
  .w-hours dd{margin:0;opacity:.8}
  .w-where-photo{min-height:320px;border-radius:calc(var(--radius) + 8px);overflow:hidden;position:relative;background:color-mix(in srgb,var(--c-accent) 14%,var(--c-panel));display:grid;place-items:center;text-align:center;padding:24px;font-size:var(--t-small)}
  .w-where-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}

  /* FAQs */
  .w-faq{max-width:820px}
  .w-faq details{background:var(--c-panel);border-radius:var(--radius);margin-bottom:10px;padding:0 22px}
  .w-faq summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;padding-block:20px;font-family:var(--f-head);font-weight:600;font-size:18px;cursor:pointer}
  .w-faq summary::-webkit-details-marker{display:none}
  .w-faq summary :global(svg){flex:none;transition:transform .25s}
  .w-faq details[open] summary :global(svg){transform:rotate(180deg)}
  .w-faq details p{padding-bottom:20px;max-width:62ch}

  /* Booking (with a booking system) */
  .w-book{display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px;padding:clamp(40px,6vw,72px) 24px;border-radius:calc(var(--radius) + 12px);background:linear-gradient(160deg,color-mix(in srgb,var(--c-accent) 18%,var(--c-panel)),var(--c-panel))}
  .w-book .lead{max-width:46ch}
  .w-book .w-ctas{justify-content:center}
</style>
