---
// Services template (Founder OS): agencies, consultants, accountants, coaches.
// Built to earn trust and book a call: a clear promise, who it's for, before and after, packages,
// results first, how we work, the founder, FAQs, then book a call.
// Content comes from src/content/site.json, colours and fonts from the founder's design system.
// Any section with no content is hidden. Photos: the founder's own, in public/images/.
// bookingUrl set (Calendly, GHL calendar...) = "Book a call" opens it; not set = the enquiry form.
import Site from '../layouts/Site.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';
const { hero, audience = [], problem, services = [], cases = [], steps = [], founder, logos = [], reviews = [], faqs = [], business: b } = site;
const booking = site.bookingUrl && /^https?:\/\//.test(site.bookingUrl) ? site.bookingUrl : null;
const cta = site.cta || 'Book a call';
const ctaHref = booking || '#quote';
const ext = booking ? { target: '_blank', rel: 'noopener' } : {};
const tel = b.phone ? `tel:${b.phone.replace(/\s/g, '')}` : null;
const realLogos = logos.filter((l) => l && l.src);
const lead = cases[0];
const moreCases = cases.slice(1, 3);
const hasProblem = problem && (problem.before?.length || problem.after?.length);
---
<Site>
  <!-- Hero: the promise, one action, the founder's photo -->
  <section class:list={['hero', { solo: !hero.image }]}>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
        <h1>{hero.title}</h1>
        <p class="lead">{hero.text}</p>
        <div class="hero-ctas">
          <a class="btn" href={ctaHref} {...ext}><Icon name="calendar-check" size={18} />{cta}</a>
          {cases.length > 0 && <a class="btn ghost" href="#results">See results</a>}
        </div>
      </div>
      {hero.image && <div class="hero-art">
        <div class="hero-photo"><img src={hero.image} alt={hero.imageAlt || ''} fetchpriority="high" /></div>
      </div>}
    </div>
  </section>

  <!-- Client logos: real ones only -->
  {realLogos.length > 0 && <section class="logos" aria-label="Clients">
    <div class="wrap logos-row">
      <p class="logos-label">{site.logosTitle || 'Trusted by'}</p>
      <ul>{realLogos.map((l) => <li><img src={l.src} alt={l.name} loading="lazy" /></li>)}</ul>
    </div>
  </section>}

  <!-- Who it's for, and the before and after -->
  {(audience.length > 0 || hasProblem) && <section class="section" id="fit">
    <div class="wrap fit-grid">
      <div class="fit-copy reveal">
        <h2>{site.fitTitle || 'Is this for you?'}</h2>
        {site.fitText && <p class="lead muted">{site.fitText}</p>}
        {audience.length > 0 && <ul class="fit-list">{audience.map((a) => <li><span class="tick"><Icon name="check" size={16} /></span>{a}</li>)}</ul>}
      </div>
      {hasProblem && <div class="ba reveal">
        {problem.before?.length > 0 && <div class="ba-card before">
          <p class="ba-label">{problem.beforeTitle || 'Where you are now'}</p>
          <ul>{problem.before.map((p) => <li><Icon name="x" size={16} />{p}</li>)}</ul>
        </div>}
        {problem.after?.length > 0 && <div class="ba-card after">
          <p class="ba-label">{problem.afterTitle || 'Where you will be'}</p>
          <ul>{problem.after.map((p) => <li><Icon name="check" size={16} />{p}</li>)}</ul>
        </div>}
      </div>}
    </div>
  </section>}

  <!-- Packages -->
  {services.length > 0 && <section class="section panel" id="services">
    <div class="wrap">
      <div class="sec-head reveal"><h2>{site.servicesTitle || 'How we can help'}</h2>{site.servicesText && <p class="lead muted">{site.servicesText}</p>}</div>
      <div class:list={['packages', `n${Math.min(services.length, 3)}`]}>
        {services.map((s) => <article class:list={['pkg', 'reveal', { featured: s.featured }]}>
          {s.featured && <span class="pkg-flag">{s.flag || 'Most chosen'}</span>}
          <h3>{s.name}</h3>
          {s.for && <p class="pkg-for">{s.for}</p>}
          {s.text && <p class="pkg-text">{s.text}</p>}
          {s.includes?.length > 0 && <ul class="pkg-inc">{s.includes.map((x) => <li><Icon name="check" size={16} />{x}</li>)}</ul>}
          <div class="pkg-foot">
            {s.from && <p class="pkg-price">{s.from}</p>}
            <a class:list={['btn', { ghost: !s.featured }]} href={ctaHref} {...ext}>{cta}</a>
          </div>
        </article>)}
      </div>
    </div>
  </section>}

  <!-- Results first -->
  {cases.length > 0 && <section class="section" id="results">
    <div class="wrap">
      <div class="sec-head reveal"><h2>{site.casesTitle || 'Results'}</h2></div>
      <article class:list={['case-lead', 'reveal', { 'no-img': !lead.image }]}>
        {lead.image && <div class="case-img"><img src={lead.image} alt={lead.imageAlt || ''} loading="lazy" /></div>}
        <div class="case-body">
          <p class="case-metric">{lead.metric}</p>
          <p class="case-result">{lead.result}</p>
          {lead.story && <p class="case-story">{lead.story}</p>}
          <p class="case-client">{lead.client}</p>
        </div>
      </article>
      {moreCases.length > 0 && <div class="case-more">
        {moreCases.map((c) => <article class="case-card reveal">
          <p class="case-metric sm">{c.metric}</p>
          <p class="case-result">{c.result}</p>
          {c.story && <p class="case-story">{c.story}</p>}
          <p class="case-client">{c.client}</p>
        </article>)}
      </div>}
    </div>
  </section>}

  <!-- How we work -->
  {steps.length > 0 && <section class="section panel" id="process">
    <div class="wrap process">
      <div class="process-head reveal">
        <h2>{site.stepsTitle || 'How we work'}</h2>
        {site.stepsText && <p class="lead muted">{site.stepsText}</p>}
        <a class="btn" href={ctaHref} {...ext}>{cta}</a>
      </div>
      <ol class="process-list">{steps.map((s, i) => <li class="reveal">
        <span class="process-n">{String(i + 1).padStart(2, '0')}</span>
        <div><h3>{s.title}</h3><p class="muted">{s.text}</p>{s.time && <p class="process-time"><Icon name="clock" size={14} />{s.time}</p>}</div>
      </li>)}</ol>
    </div>
  </section>}

  <!-- The founder -->
  {founder?.name && <section class="section" id="about">
    <div class:list={['wrap', 'founder', { 'no-img': !founder.image }]}>
      {founder.image && <div class="founder-photo reveal"><img src={founder.image} alt={founder.imageAlt || founder.name} loading="lazy" /></div>}
      <div class="founder-copy reveal">
        {founder.quote && <blockquote><Icon name="quotes" size={36} weight="fill" /><p>{founder.quote}</p></blockquote>}
        <div class="founder-id"><p class="founder-name">{founder.name}</p>{founder.role && <p class="muted">{founder.role}</p>}</div>
        {founder.bio && <p class="founder-bio">{founder.bio}</p>}
        {founder.creds?.length > 0 && <ul class="creds">{founder.creds.map((c) => <li>{c}</li>)}</ul>}
      </div>
    </div>
  </section>}

  <!-- Reviews: real ones only -->
  {reviews.length > 0 && <section class="section panel" id="reviews">
    <div class="wrap">
      <div class="sec-head reveal"><h2>{site.reviewsTitle || 'What clients say'}</h2></div>
      <div class:list={['quotes', reviews.length === 3 ? 'q3' : reviews.length === 2 ? 'q2' : 'qn']}>{reviews.map((r) => <blockquote class="quote reveal">
        <p>{r.quote}</p>
        <footer><strong>{r.name}</strong>{r.role && <span>{r.role}</span>}</footer>
      </blockquote>)}</div>
    </div>
  </section>}

  <!-- FAQs -->
  {faqs.length > 0 && <section class="section" id="faqs">
    <div class="wrap faq-row">
      <div class="faq-side reveal">
        <h2>Questions</h2>
        <p class="muted">Something else? {b.email ? <a href={`mailto:${b.email}`}>{b.email}</a> : tel ? <a href={tel}>{b.phone}</a> : 'Ask us on the call.'}</p>
      </div>
      <div class="faq-list">{faqs.map((f) => <details class="reveal"><summary>{f.q}<Icon name="caret-down" size={20} /></summary><p class="muted">{f.a}</p></details>)}</div>
    </div>
  </section>}

  <!-- Book a call: their calendar if they have one, otherwise the enquiry form -->
  {booking ? (
    <section class="book" id="quote">
      <div class="wrap book-row">
        <div class="stack" style="gap:14px">
          <h2>{site.bookTitle || 'Book a call'}</h2>
          <p class="lead">{site.bookText || 'A short call to see if we are the right fit. No pitch, no pressure.'}</p>
        </div>
        <div class="book-actions">
          <a class="btn" href={booking} target="_blank" rel="noopener"><Icon name="calendar-check" size={18} />{cta}</a>
          {tel && <a class="book-alt" href={tel}><Icon name="phone" size={16} />{b.phone}</a>}
          {b.email && <a class="book-alt" href={`mailto:${b.email}`}><Icon name="envelope-simple" size={16} />{b.email}</a>}
        </div>
      </div>
    </section>
  ) : (
    <QuoteForm title={site.bookTitle || 'Book a call'} text={site.bookText || 'Tell us a little about your business and we will set up a short call.'} />
  )}
</Site>

<style>
  /* Hero */
  .hero{padding-block:clamp(40px,6vw,80px) clamp(56px,8vw,96px)}
  .hero-grid{display:grid;gap:clamp(32px,5vw,72px);align-items:center}
  @media(min-width:900px){.hero-grid{grid-template-columns:1.15fr .85fr}}
  .hero.solo .hero-grid{grid-template-columns:1fr}
  .hero-copy{display:flex;flex-direction:column;gap:22px}
  .hero.solo .hero-copy{max-width:780px}
  .hero h1{font-size:clamp(36px,5.4vw,calc(var(--t-h1) * 1.45));letter-spacing:-.03em;line-height:1.02}
  .hero .eyebrow{color:var(--c-accent-text);display:inline-flex;align-items:center;gap:10px}
  .hero .eyebrow::before{content:"";width:24px;height:2px;background:var(--c-accent)}
  .hero .lead{opacity:.8}
  .hero-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:6px}
  .hero-art{position:relative;padding:0 0 24px 24px}
  .hero-art::before{content:"";position:absolute;inset:24px 24px 0 0;border-radius:var(--radius);background:color-mix(in srgb,var(--c-accent) 26%,var(--c-panel))}
  .hero-photo{position:relative;aspect-ratio:4/5;border-radius:var(--radius);overflow:hidden;background:var(--c-panel)}
  .hero-photo img{width:100%;height:100%;object-fit:cover}
  @media(max-width:899px){.hero-art{max-width:440px}.hero-photo{aspect-ratio:5/4}}
  @media (prefers-reduced-motion:no-preference){.hero-copy > *,.hero-art{animation:up .8s cubic-bezier(.16,1,.3,1) both}.hero-copy > :nth-child(2){animation-delay:.06s}.hero-copy > :nth-child(3){animation-delay:.12s}.hero-copy > :nth-child(4){animation-delay:.18s}.hero-art{animation-delay:.2s}}
  @keyframes up{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}

  /* Logos */
  .logos{border-block:1px solid color-mix(in srgb,var(--c-text) 10%,transparent)}
  .logos-row{display:flex;align-items:center;gap:24px 40px;flex-wrap:wrap;padding-block:28px}
  .logos-label{font-size:var(--t-small);font-weight:600;opacity:.6;white-space:nowrap}
  .logos ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;align-items:center;gap:20px 44px;flex:1}
  .logos img{height:28px;width:auto;filter:grayscale(1);opacity:.7}
  @media(max-width:700px){.logos-row{flex-direction:column;align-items:flex-start;gap:16px}.logos ul{gap:16px 32px}.logos img{height:24px}}

  /* Fit */
  .fit-grid{display:grid;gap:clamp(36px,5vw,72px);align-items:start}
  @media(min-width:900px){.fit-grid{grid-template-columns:1fr 1fr}}
  .fit-copy{display:flex;flex-direction:column;gap:18px}
  .fit-list{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column;gap:14px}
  .fit-list li{display:flex;gap:14px;align-items:flex-start;font-size:18px;font-weight:500}
  .tick{flex:none;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--c-accent);color:var(--c-on-accent);margin-top:1px}
  .ba{display:grid;gap:14px}
  .ba-card{border-radius:var(--radius);padding:clamp(22px,3vw,32px)}
  .ba-card ul{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:12px}
  .ba-card li{display:flex;gap:12px;align-items:flex-start}
  .ba-card li :global(svg){flex:none;margin-top:4px}
  .ba-label{font-family:var(--f-head);font-weight:700;font-size:19px}
  .before{background:var(--c-panel);color:color-mix(in srgb,var(--c-text) 72%,transparent)}
  .before li :global(svg){opacity:.55}
  .after{background:var(--c-text);color:var(--c-bg)}
  .after li :global(svg){color:var(--c-accent)}

  /* Packages */
  .packages{display:grid;gap:20px;align-items:stretch}
  @media(min-width:900px){.packages.n2{grid-template-columns:1fr 1fr}.packages.n3{grid-template-columns:1fr 1.15fr 1fr}}
  .pkg{position:relative;background:var(--c-bg);border:1px solid color-mix(in srgb,var(--c-text) 12%,transparent);border-radius:var(--radius);padding:clamp(24px,3vw,34px);display:flex;flex-direction:column;gap:12px}
  .pkg.featured{background:var(--c-text);color:var(--c-bg);border-color:var(--c-text);box-shadow:0 30px 60px -36px color-mix(in srgb,var(--c-text) 80%,transparent)}
  @media(min-width:900px){.packages.n3 .pkg.featured{margin-block:-16px}}
  .pkg-flag{align-self:flex-start;background:var(--c-accent);color:var(--c-on-accent);font-size:13px;font-weight:700;padding:5px 10px;border-radius:var(--radius)}
  .pkg h3{font-size:24px}
  .pkg-for{font-weight:600;opacity:.7;font-size:15px}
  .pkg-text{opacity:.85}
  .pkg-inc{list-style:none;margin:6px 0 0;padding:16px 0 0;border-top:1px solid color-mix(in srgb,currentColor 15%,transparent);display:flex;flex-direction:column;gap:10px}
  .pkg-inc li{display:flex;gap:10px;align-items:flex-start;font-size:15px}
  .pkg-inc li :global(svg){flex:none;margin-top:4px;color:var(--c-accent-text)}
  .pkg.featured .pkg-inc li :global(svg){color:var(--c-accent)}
  .pkg-foot{margin-top:auto;padding-top:18px;display:flex;flex-direction:column;gap:14px}
  .pkg-price{font-family:var(--f-head);font-size:22px;font-weight:700}
  .pkg.featured .btn.ghost{color:var(--c-bg)}

  /* Results */
  .case-lead{display:grid;border-radius:var(--radius);overflow:hidden;background:var(--c-panel)}
  @media(min-width:900px){.case-lead{grid-template-columns:1fr 1fr}.case-lead.no-img{grid-template-columns:1fr}}
  .case-img{min-height:320px;position:relative}
  .case-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .case-body{padding:clamp(28px,4vw,56px);display:flex;flex-direction:column;justify-content:center;gap:14px}
  .case-metric{font-family:var(--f-head);font-weight:800;font-size:clamp(56px,8vw,96px);line-height:.95;letter-spacing:-.04em;color:var(--c-accent-text)}
  .case-metric.sm{font-size:clamp(44px,5vw,64px)}
  .case-result{font-family:var(--f-head);font-weight:700;font-size:21px;line-height:1.25}
  .case-story{opacity:.8;max-width:52ch}
  .case-client{font-size:var(--t-small);font-weight:600;opacity:.65;margin-top:4px}
  .case-more{display:grid;gap:20px;margin-top:20px}
  @media(min-width:760px){.case-more{grid-template-columns:1fr 1fr}}
  .case-card{border:1px solid color-mix(in srgb,var(--c-text) 12%,transparent);border-radius:var(--radius);padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:12px}

  /* Process */
  .process{display:grid;gap:clamp(36px,5vw,80px)}
  @media(min-width:900px){.process{grid-template-columns:.8fr 1.2fr}.process-head{position:sticky;top:110px;align-self:start}}
  .process-head{display:flex;flex-direction:column;gap:18px;align-items:flex-start}
  .process-list{list-style:none;margin:0;padding:0}
  .process-list li{display:grid;grid-template-columns:72px 1fr;gap:20px;padding-block:28px;border-top:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .process-list li:first-child{border-top:0;padding-top:0}
  .process-list li div{display:flex;flex-direction:column;gap:8px}
  .process-n{font-family:var(--f-head);font-weight:800;font-size:40px;line-height:1;color:var(--c-accent-text);letter-spacing:-.03em}
  .process-time{display:inline-flex;align-items:center;gap:6px;font-size:var(--t-small);font-weight:600;opacity:.7}

  /* Founder */
  .founder{display:grid;gap:clamp(32px,5vw,72px);align-items:center}
  @media(min-width:900px){.founder{grid-template-columns:.8fr 1.2fr}.founder.no-img{grid-template-columns:1fr;max-width:820px}}
  .founder-photo{aspect-ratio:4/5;border-radius:var(--radius);overflow:hidden;background:var(--c-panel);position:relative}
  .founder-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  @media(max-width:899px){.founder-photo{max-width:420px;aspect-ratio:1}}
  .founder-copy{display:flex;flex-direction:column;gap:20px}
  .founder blockquote{margin:0;display:flex;flex-direction:column;gap:14px;color:var(--c-accent-text)}
  .founder blockquote p{font-family:var(--f-head);font-weight:700;font-size:clamp(24px,3.2vw,34px);line-height:1.2;letter-spacing:-.015em;color:var(--c-text)}
  .founder-name{font-weight:700;font-size:18px}
  .founder-bio{max-width:58ch;opacity:.85}
  .creds{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
  .creds li{padding:7px 12px;border-radius:999px;background:var(--c-panel);font-size:14px;font-weight:600}

  /* Reviews */
  .quotes{display:grid;gap:20px}
  @media(min-width:760px){.quotes.q2{grid-template-columns:1fr 1fr}.quotes.q3{grid-template-columns:1.25fr 1fr}.quotes.q3 .quote:first-child{grid-row:span 2;justify-content:center}.quotes.q3 .quote:first-child p{font-family:var(--f-head);font-weight:700;font-size:clamp(22px,2.6vw,28px);line-height:1.3;letter-spacing:-.01em}.quotes.qn{display:block;columns:2;column-gap:20px}.quotes.qn .quote{margin-bottom:20px}}
  .quote{break-inside:avoid;margin:0;background:var(--c-bg);border-radius:var(--radius);padding:26px;display:flex;flex-direction:column;gap:14px;border:1px solid color-mix(in srgb,var(--c-text) 10%,transparent)}
  .quote p{font-size:18px;line-height:1.5}
  .quote footer{display:flex;flex-direction:column;font-size:var(--t-small)}
  .quote footer span{opacity:.65}

  /* FAQs */
  .faq-row{display:grid;gap:36px}
  @media(min-width:900px){.faq-row{grid-template-columns:.8fr 1.2fr}.faq-side{position:sticky;top:110px;align-self:start}}
  .faq-side{display:flex;flex-direction:column;gap:14px}
  .faq-list details{border-top:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .faq-list details:last-child{border-bottom:1px solid color-mix(in srgb,var(--c-text) 14%,transparent)}
  .faq-list summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;padding-block:22px;font-family:var(--f-head);font-weight:700;font-size:19px;cursor:pointer}
  .faq-list summary::-webkit-details-marker{display:none}
  .faq-list summary :global(svg){flex:none;transition:transform .25s}
  .faq-list details[open] summary :global(svg){transform:rotate(180deg)}
  .faq-list details p{padding-bottom:22px;max-width:60ch}

  /* Book a call (calendar link) */
  .book{background:var(--c-accent);color:var(--c-on-accent);padding-block:clamp(56px,8vw,96px)}
  .book-row{display:grid;gap:32px;align-items:center}
  @media(min-width:900px){.book-row{grid-template-columns:1.3fr 1fr}}
  .book h2{font-size:clamp(30px,4.6vw,calc(var(--t-h2) * 1.7))}
  .book-actions{display:flex;flex-direction:column;align-items:flex-start;gap:14px}
  .book .btn{background:var(--c-text);border-color:var(--c-text);color:var(--c-bg)}
  .book-alt{display:inline-flex;align-items:center;gap:8px;font-weight:600;text-decoration:none}
  .book-alt:hover{text-decoration:underline}
</style>
